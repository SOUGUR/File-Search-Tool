# Copy to backend/.env and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=your_api_key_here

# --- Models ---
# DEFAULT_MODEL=gemini-3-flash-preview
# Comma-separated list users may choose from (empty = auto-discover from the API)
# ALLOWED_MODELS=gemini-3-flash-preview,gemini-3.1-pro-preview
# Embedding model for NEW stores only (empty = Google default)
# EMBEDDING_MODEL=models/gemini-embedding-001

# --- Stores ---
# SHARED_STORE_NAME=my-rag-store
# USER_STORE_PREFIX=user-

# --- Capacity / abuse limits ---
# MAX_CONCURRENT_GEMINI_CALLS=16
# GEMINI_QUEUE_TIMEOUT_S=30
# CHAT_REQUESTS_PER_MINUTE=20
# UPLOADS_PER_HOUR=30
# MAX_UPLOAD_MB=100
# MAX_DOCUMENTS_PER_USER=50
# CORS_ORIGINS=*
# DB_PATH=backend/var/app.db
